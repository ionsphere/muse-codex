{
  "name": "muse-codex",
  "version": "0.2.0",
  "description": "Cross-platform Codex-style harness for Meta Muse Spark, with WSL as the first complete runtime",
  "type": "module",
  "scripts": {
    "muse": "tsx src/index.ts",
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "test": "tsx --test test/fs-tools.test.ts test/auth.test.ts test/harness.test.ts",
    "check": "npm run build && npm test"
  },
  "dependencies": {
    "diff": "^5.1.0",
    "dotenv": "^16.4.0"
  },
  "devDependencies": {
    "@types/diff": "^5.2.1",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0"
  }
}
