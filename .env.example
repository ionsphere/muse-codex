# Meta Model API
META_MODEL_API_KEY=
META_MODEL_API_BASE_URL=https://api.meta.ai/v1
META_MODEL_API_MODEL=muse-spark-1.2

# Select any registered provider/model. Examples:
# ZEAL_MODEL=kimi/kimi-k2
# ZEAL_MODEL=qwen/qwen3-coder-plus
# ZEAL_MODEL=openai/gpt-5.4
# ZEAL_MODEL=openrouter/qwen/qwen3-coder
ZEAL_PROVIDER=meta
OPENAI_API_KEY=
XAI_API_KEY=
MOONSHOT_API_KEY=
DASHSCOPE_API_KEY=
OPENROUTER_API_KEY=
# Any OpenAI-compatible endpoint is registered as provider "custom".
ZEAL_API_BASE=
ZEAL_API_KEY=

# Harness
WORKDIR=./workdir
# auto | wsl | linux | macos | windows | ios
ZEAL_PLATFORM=auto
ZEAL_MAX_STEPS=100
ZEAL_COMMAND_TIMEOUT_MS=120000
ZEAL_MAX_AGENTS=4
