# Meta Model API
META_MODEL_API_KEY=
META_MODEL_API_BASE_URL=https://api.meta.ai/v1
META_MODEL_API_MODEL=muse-spark-1.2

# Select any registered provider/model. Examples:
# MUSE_MODEL=kimi/kimi-k2
# MUSE_MODEL=qwen/qwen3-coder-plus
# MUSE_MODEL=openai/gpt-5.4
# MUSE_MODEL=openrouter/qwen/qwen3-coder
MUSE_PROVIDER=meta
OPENAI_API_KEY=
XAI_API_KEY=
MOONSHOT_API_KEY=
DASHSCOPE_API_KEY=
OPENROUTER_API_KEY=
# Any OpenAI-compatible endpoint is registered as provider "custom".
MUSE_API_BASE=
MUSE_API_KEY=

# Harness
WORKDIR=./workdir
# auto | wsl | linux | macos | windows | ios
MUSE_PLATFORM=auto
MUSE_MAX_STEPS=100
MUSE_COMMAND_TIMEOUT_MS=120000
MUSE_MAX_AGENTS=4
